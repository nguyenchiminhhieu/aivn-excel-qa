<mxfile host="app.diagrams.net" type="device"><diagram id="v3i" name="1. Kiến trúc v3 (đã triển khai)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v3i_1" value="&lt;span style=&#x27;font-size:20px&#x27;&gt;&lt;b&gt;Excel QA – kiến trúc v3 (đã triển khai, Qwen3.7 Flash)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Ba ý tưởng chính: (1) parser khôi phục cấu trúc từ tín hiệu tổng quát; (2) đưa dữ liệu cho LLM dưới dạng &lt;b&gt;pandas DataFrame quen thuộc&lt;/b&gt;; (3) &lt;b&gt;hai cách suy luận khác loại&lt;/b&gt; chạy song song, đồng ý thì trả lời ngay, chỉ khi bất đồng mới tốn reasoning." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2d3640;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="60" as="geometry"/></mxCell><mxCell id="v3i_2" value="&lt;b&gt;Chú giải&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1520" y="20" width="210" height="26" as="geometry"/></mxCell><mxCell id="v3i_3" value="gọi LLM (Qwen3.7 Flash)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#fbe3cc;strokeColor=#c0661a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1520" y="50" width="210" height="30" as="geometry"/></mxCell><mxCell id="v3i_4" value="code tất định" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;" vertex="1" parent="1"><mxGeometry x="1520" y="86" width="210" height="30" as="geometry"/></mxCell><mxCell id="v3i_5" value="vào / ra" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#ffffff;strokeColor=#6b7785;" vertex="1" parent="1"><mxGeometry x="1520" y="122" width="210" height="30" as="geometry"/></mxCell><mxCell id="v3i_6" value="mới ở v3 (viền đậm)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1520" y="158" width="210" height="30" as="geometry"/></mxCell><mxCell id="v3i_7" value="A. MỖI WORKBOOK – 1 lần, không gọi LLM, có cache" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#9aa5b1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4a5561;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="1710" height="300" as="geometry"/></mxCell><mxCell id="v3i_8" value="&lt;b&gt;Workbook Excel&lt;/b&gt;&lt;br&gt;nhiều sheet · nhiều file&lt;br&gt;file_name: chuỗi hoặc danh sách" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#ffffff;strokeColor=#6b7785;" vertex="1" parent="1"><mxGeometry x="40" y="140" width="200" height="120" as="geometry"/></mxCell><mxCell id="v3i_9" value="&lt;b&gt;Khôi phục cấu trúc&lt;/b&gt;&lt;br&gt;ô gộp · công thức · số/ngày bẩn&lt;br&gt;vùng bảng · header nhiều tầng · key–value&lt;br&gt;&lt;b&gt;mới:&lt;/b&gt; header xuống dòng · hàng mã định danh&lt;br&gt;· nhãn thời gian (năm/quý) · tiêu đề nhóm&lt;br&gt;  trong cây thụt lề · ký hiệu thiếu (-8-)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="280" y="110" width="300" height="180" as="geometry"/></mxCell><mxCell id="v3i_10" value="&lt;b&gt;TableIR&lt;/b&gt;&lt;br&gt;đường dẫn hàng cha › con&lt;br&gt;cờ: dòng tổng / có hàng con&lt;br&gt;mỗi giá trị kèm ô A1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;" vertex="1" parent="1"><mxGeometry x="620" y="140" width="220" height="120" as="geometry"/></mxCell><mxCell id="v3i_11" value="&lt;b&gt;DataFrame cho chương trình&lt;/b&gt;&lt;br&gt;T0, T1, … : row · path · level_k ·&lt;br&gt;is_summary · has_children ·&lt;br&gt;cột giá trị tên đọc được&lt;br&gt;+ facts (giá trị, ô A1)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="260" height="150" as="geometry"/></mxCell><mxCell id="v3i_12" value="&lt;b&gt;Bản đồ cho LLM&lt;/b&gt;&lt;br&gt;&lt;b&gt;lớp ngữ nghĩa cột:&lt;/b&gt; rate / average /&lt;br&gt;count / code / year · cộng dồn được?&lt;br&gt;đơn vị từ caption · profile bảng lớn&lt;br&gt;⟦đánh dấu text đáng ngờ⟧" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1180" y="110" width="280" height="160" as="geometry"/></mxCell><mxCell id="v3i_13" value="đọc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_8" target="v3i_9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_14" value="dựng cây" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_9" target="v3i_10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_15" value="xuất" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_10" target="v3i_11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_16" value="render" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3i_10" target="v3i_12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_17" value="B. MỖI CÂU HỎI (mọi ngôn ngữ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;dashed=1;fillColor=none;strokeColor=#9aa5b1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#4a5561;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="1710" height="630" as="geometry"/></mxCell><mxCell id="v3i_18" value="&lt;b&gt;Câu hỏi&lt;/b&gt;&lt;br&gt;EN · VI · KO · ZH …" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#ffffff;strokeColor=#6b7785;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="170" height="90" as="geometry"/></mxCell><mxCell id="v3i_19" value="Bước 1 – song song, tắt reasoning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f7f9fb;strokeColor=#6b7785;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="260" y="440" width="700" height="190" as="geometry"/></mxCell><mxCell id="v3i_20" value="&lt;b&gt;P1: chương trình pandas&lt;/b&gt;&lt;br&gt;JSON: diễn giải + đặc tả đầu ra&lt;br&gt;code chạy trong sandbox trên T0…&lt;br&gt;sửa 1 lần nếu lỗi" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#fbe3cc;strokeColor=#c0661a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="480" width="320" height="130" as="geometry"/></mxCell><mxCell id="v3i_21" value="&lt;b&gt;P2: đọc trực tiếp&lt;/b&gt;&lt;br&gt;LLM đọc bản đồ, trả lời bằng văn bản&lt;br&gt;(bảng ≤ 150 hàng; nếu lớn hơn:&lt;br&gt;mẫu P1 thứ hai)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#fbe3cc;strokeColor=#c0661a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="480" width="320" height="130" as="geometry"/></mxCell><mxCell id="v3i_22" value="&lt;b&gt;Định dạng theo đặc tả&lt;/b&gt;&lt;br&gt;số chữ số thập phân · danh sách&lt;br&gt;regex đa ngôn ngữ dự phòng" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1010" y="480" width="240" height="110" as="geometry"/></mxCell><mxCell id="v3i_23" value="P1 = P2&lt;br&gt;và có căn cứ&lt;br&gt;trong dữ liệu?" style="rhombus;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#4a5561;" vertex="1" parent="1"><mxGeometry x="1300" y="465" width="170" height="140" as="geometry"/></mxCell><mxCell id="v3i_24" value="&lt;b&gt;submission.csv&lt;/b&gt;&lt;br&gt;luôn đủ 1 dòng / câu" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#ffffff;strokeColor=#6b7785;" vertex="1" parent="1"><mxGeometry x="1520" y="495" width="190" height="80" as="geometry"/></mxCell><mxCell id="v3i_25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_18" target="v3i_19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_26" value="DataFrame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="v3i_11" target="v3i_20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_27" value="bản đồ" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="v3i_12" target="v3i_21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_28" value="2 đáp án" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_19" target="v3i_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_22" target="v3i_23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_30" value="Có (79/113 câu: 99% đúng)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_23" target="v3i_24"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_31" value="Bước 2 – chỉ khi bất đồng, bật reasoning" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;fillColor=#f7f9fb;strokeColor=#6b7785;verticalAlign=top;align=center;fontStyle=1;fontSize=12;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="260" y="700" width="700" height="190" as="geometry"/></mxCell><mxCell id="v3i_32" value="&lt;b&gt;P1 ×2&lt;/b&gt;&lt;br&gt;reasoning low&lt;br&gt;nhiệt độ 0 và 0.5" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#fbe3cc;strokeColor=#c0661a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="280" y="745" width="200" height="110" as="geometry"/></mxCell><mxCell id="v3i_33" value="&lt;b&gt;P2&lt;/b&gt;&lt;br&gt;reasoning low" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#fbe3cc;strokeColor=#c0661a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="500" y="745" width="200" height="110" as="geometry"/></mxCell><mxCell id="v3i_34" value="&lt;b&gt;Bỏ phiếu&lt;/b&gt;&lt;br&gt;trên mọi ứng viên sạch&lt;br&gt;của cả 2 bước" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;" vertex="1" parent="1"><mxGeometry x="720" y="745" width="220" height="110" as="geometry"/></mxCell><mxCell id="v3i_35" value="&lt;b&gt;Trọng tài&lt;/b&gt;&lt;br&gt;chỉ khi hòa phiếu&lt;br&gt;đọc code + kết quả in ra" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#fbe3cc;strokeColor=#c0661a;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1010" y="760" width="240" height="90" as="geometry"/></mxCell><mxCell id="v3i_36" value="Không" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3i_23" target="v3i_31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_31" target="v3i_34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_38" value="đa số" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3i_34" target="v3i_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_39" value="hòa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="v3i_34" target="v3i_35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_40" value="chọn" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#4a5561;fontSize=11;fontColor=#2d3640;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="v3i_35" target="v3i_22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="v3i_41" value="&lt;b&gt;Độ chính xác theo đường quyết định&lt;/b&gt; (Qwen, 113 câu: public 2, public 1, robust, cross)&lt;br&gt;• Bước 1, hai cách khác loại đồng ý: &lt;b&gt;78/79 (99%)&lt;/b&gt;&lt;br&gt;• Bước 2, bỏ phiếu: 26/30 (87%)&lt;br&gt;• Trọng tài: 2/3&lt;br&gt;&lt;br&gt;&lt;b&gt;Xuyên suốt:&lt;/b&gt; ngân sách thời gian · fallback · trace từng câu · đáp án chỉ lấy từ kết quả thực thi" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2d3640;" vertex="1" parent="1"><mxGeometry x="1300" y="700" width="420" height="190" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="stack" name="2. Tech stack"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="stack_1" value="&lt;span style=&#x27;font-size:20px&#x27;&gt;&lt;b&gt;Tech stack của v3&lt;/b&gt;&lt;/span&gt;&lt;br&gt;Python 3.11 · 4 thư viện ngoài: openpyxl, pandas, numpy, openai. Không GPU, không vector DB, không fine-tune. RAM đỉnh ~186 MB." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#2d3640;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1400" height="50" as="geometry"/></mxCell><mxCell id="stack_2" value="&lt;b&gt;Vào&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;xlsx_files/ + queries.json&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="stack_3" value="&lt;b&gt;openpyxl&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;đọc ô, ô gộp, thụt lề, font đậm,&lt;br&gt;định dạng % / ngày, sheet ẩn&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#eaf1fb;strokeColor=#3a6ea5;" vertex="1" parent="1"><mxGeometry x="280" y="80" width="290" height="100" as="geometry"/></mxCell><mxCell id="stack_4" value="&lt;b&gt;2 lần nạp&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;công thức + giá trị cache (data_only)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#eaf1fb;strokeColor=#3a6ea5;" vertex="1" parent="1"><mxGeometry x="580" y="80" width="290" height="100" as="geometry"/></mxCell><mxCell id="stack_5" value="&lt;b&gt;Hiểu bảng tính&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px&#x27;&gt;excel_parser.py (tự viết)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;spacing=6;fillColor=#dcefe4;strokeColor=#1f6f4a;" vertex="1" parent="1"